{
  "cli": {
    "version": ">= 0.51.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "releaseChannel": "dev-v1",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug"
      }
    },
    "beta": {
      "distribution": "internal",
      "releaseChannel": "beta-v2",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "releaseChannel": "prod-v2",
      "distribution": "store",
      "android": {
        "image": "default"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
