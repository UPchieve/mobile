{
  "expo": {
    "name": "UPchieve",
    "slug": "upchieve-app",
    "scheme": "com.upchieve.app",
    "version": "2.9.16",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/cdcdb1c0-12ce-4ead-8fce-dcae0af1a5f3"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "The app accesses your photos to let you add them into the whiteboard!.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone"
      },
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "org.upchieve.mobile"
    },
    "android": {
      "versionCode": 209016,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16D2AA"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "package": "org.upchieve.mobile"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/messaging",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you add them into the whiteboard!."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "34.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-localization",
      "newrelic-react-native-agent"
    ],
    "extra": {
      "eas": {
        "projectId": "cdcdb1c0-12ce-4ead-8fce-dcae0af1a5f3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
