{
  "name": "upchieve-app",
  "version": "2.9.8",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "prebuild": "npx expo prebuild",
    "start:development": "NODE_ENV=development expo start --dev-client",
    "start:beta": "NODE_ENV=production expo start --dev-client",
    "preview:android": "NODE_ENV=production npx expo run:android --variant release",
    "preview:ios": "NODE_ENV=beta npx expo run:ios --configuration Release",
    "android:development": "NODE_ENV=development expo run:android",
    "android:beta": "NODE_ENV=beta expo run:android",
    "ios:development": "NODE_ENV=development expo run:ios",
    "ios:beta": "NODE_ENV=beta expo run:ios",
    "update:development": "npx eas update --channel dev-v1",
    "update:beta": "npx eas update --channel beta-v2",
    "update:production": "npx eas update --channel prod-v2",
    "build:development": "npx eas build --profile development --platform all",
    "build:beta": "npx eas build --profile beta --platform all",
    "build:production": "npx eas build --profile production --platform all",
    "lint": "prettier --write .> /dev/null",
    "lint:check": "prettier . --check",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "devtools": "react-devtools",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/hooks": "^3.0.0",
    "@react-native-firebase/analytics": "^19.0.1",
    "@react-native-firebase/app": "^19.0.1",
    "@react-native-firebase/crashlytics": "^19.0.1",
    "@react-native-firebase/messaging": "^19.0.1",
    "@react-navigation/drawer": "^6.6.14",
    "@react-navigation/elements": "^1.3.29",
    "@react-navigation/native": "^6.1.16",
    "@react-navigation/native-stack": "^6.9.25",
    "axios": "^1.6.7",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "dayjs": "^1.11.10",
    "expo": "~52.0.44",
    "expo-application": "~6.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-keep-awake": "~14.0.3",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.1",
    "expo-screen-orientation": "~8.0.4",
    "expo-sensors": "~14.0.2",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.4",
    "exponential-backoff": "^3.1.1",
    "formik": "^2.4.5",
    "jest": "^29.3.1",
    "newrelic-react-native-agent": "^1.3.7",
    "posthog-react-native": "^2.11.6",
    "random-string": "^0.2.0",
    "react": "18.3.1",
    "react-countdown": "^2.3.5",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-gleapsdk": "^13.5.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-mask-text": "^0.14.2",
    "react-native-modal": "^13.0.1",
    "react-native-modal-popover": "^2.1.3",
    "react-native-modal-selector": "^2.1.2",
    "react-native-modalize": "^2.1.1",
    "react-native-popup-menu": "^0.16.1",
    "react-native-read-more-text": "^1.1.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "socket.io-client": "^2.3.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-native-dotenv": "^0.2.2",
    "@types/react-native-read-more-text": "^1.0.4",
    "@types/react-test-renderer": "^18.3.1",
    "@types/socket.io-client": "^3.0.0",
    "jest-expo": "~52.0.6",
    "prettier": "^3.2.5",
    "react-devtools": "^5.0.2",
    "react-native-svg-transformer": "^1.3.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.0"
  },
  "private": true
}
